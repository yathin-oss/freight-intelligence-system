# ============================================================================
# SIH26006 Freight Intelligence Platform - environment variable reference
# ============================================================================
# This root file documents every variable used across the stack. In practice:
#   - backend/.env.example  -> copy to backend/.env for local (non-Docker) runs
#   - frontend/.env.example -> copy to frontend/.env.local for local (non-Docker) runs
#   - docker-compose.yml already sets sane defaults for `docker compose up`
#
# Never commit a real .env file with secrets. This is a hackathon prototype
# with no paid API keys required anywhere in the stack.

# ---- Backend --------------------------------------------------------------
# Switch between SQLite (zero setup) and PostgreSQL (docker compose) with
# ONE variable - nothing else in the codebase needs to change.
#   SQLite (default, local dev):
DATABASE_URL=sqlite:///./backend/freight.db
#   PostgreSQL (docker compose):
# DATABASE_URL=postgresql+psycopg2://freight:freight@localhost:5432/freight

# Model / data replacement points (see README "Model Replacement")
ML_MODEL_PATH=./ml/models/freight_model.joblib
DATA_PATH=./data/synthetic

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Frontend ---------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Optional: a remote MapLibre-compatible style.json (e.g. OpenFreeMap/MapTiler)
# for a richer basemap. Leave blank to use the bundled offline basemap - the
# app is fully functional either way. No API key is required for the default
# (offline) map, satisfying the "no expensive API key dependency" constraint.
NEXT_PUBLIC_MAP_STYLE_URL=
