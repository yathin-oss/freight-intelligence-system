# Base URL the browser uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional: point at a real vector-tile basemap style (e.g. an OpenFreeMap or
# MapTiler style.json URL) for a richer-looking basemap. If unset, or if this
# URL fails to load at runtime, the Global Network map automatically falls
# back to the bundled local world-countries GeoJSON basemap
# (public/data/world-countries.geojson) so the map is never a hard
# dependency on an external tile provider during a demo.
NEXT_PUBLIC_MAP_STYLE_URL=

# Supabase project used as the data store (ports, routes, origins, vessel
# classes, disruption events, decision-run history) once wired up. Use the
# Project URL and the anon/public key only (Settings -> API in the Supabase
# dashboard) - never the service_role key here, RLS policies gate access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
